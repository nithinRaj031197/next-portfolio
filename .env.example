# Copy to .env.local for local development. Never commit real values or secrets: this site needs none.

# REQUIRED for production builds. The public origin, without a trailing slash.
# Canonical URL, Open Graph, sitemap, robots and JSON-LD all derive from it. `next build` fails if it is missing
# (Vercel's own URLs are used automatically when deploying there). Leave empty locally: dev falls back to http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# OPTIONAL, but expected before launch. A public résumé PDF with no phone number: either a path under /public
# (for example /resume.pdf) or an external https URL. When empty, every Resume button and link is omitted.
NEXT_PUBLIC_RESUME_URL=
